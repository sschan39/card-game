{
  "name": "card-game",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "typecheck:server": "tsc -b apps/server",
    "typecheck:client": "tsc -b apps/game-client",
    "build": "npm run build:server && npm run build:client && npm run build:admin && npm run build:deck-builder",
    "build:admin": "npm run build -w @card-game/admin",
    "typecheck:admin": "tsc -b apps/admin",
    "dev:admin": "npm run dev -w @card-game/admin",
    "build:server": "npm run build -w @card-game/server",
    "build:client": "npm run build -w @card-game/client",
    "start": "npm run start -w @card-game/server",
    "dev": "npm run build:server && node apps/server/dist/index.js --vite",
    "dev:client": "npm run dev -w @card-game/client",
    "test": "vitest run",
    "test:architecture": "vitest run --pool=threads --maxWorkers=1 tests/architecture/import-boundaries.test.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "build:deck-builder": "npm run build -w @card-game/deck-builder",
    "dev:deck-builder": "npm run dev -w @card-game/deck-builder",
    "typecheck:deck-builder": "tsc -b apps/deck-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "argon2@0.45.1": true
  }
}
