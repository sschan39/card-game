# Replace hostnames/certificate paths and install only after target-host validation.
# Pair with CONFIG_FILE=deploy/platform-config.example.json (adjust its domains).
# The backend must be private; this local proxy overwrites forwarded identity.
server {
    listen 443 ssl;
    server_name game.example.test;
    ssl_certificate /etc/letsencrypt/live/game.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/game.example.test/privkey.pem;
    root /opt/cardgame/apps/game-client/dist;
    # Game positioning uses inline styles; executable inline scripts remain disallowed.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /deck-builder { return 302 /deck-builder/; }
    location /deck-builder/ { alias /opt/cardgame/apps/deck-builder/dist/; index index.html; }
    location ^~ /admin/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
# Validate with nginx -t, then verify TLS, API JSON fallback, websocket upgrade,
# cookie flags and trusted-proxy/client-IP behavior on the installed host.
