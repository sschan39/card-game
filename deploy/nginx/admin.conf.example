# Adapt domains/certificate paths to the intended host; never deploy example values unchanged.
# The admin origin serves only its own frontend and proxies its API to the shared backend.
server {
    listen 443 ssl;
    server_name admin.example.test;
    ssl_certificate /etc/letsencrypt/live/admin.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.test/privkey.pem;
    root /opt/cardgame/apps/admin/dist;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = / { return 302 /admin/; }
    location /admin/ { alias /opt/cardgame/apps/admin/dist/; index index.html; }
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /socket.io/ { return 404; }
}
