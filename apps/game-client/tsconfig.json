{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../../packages/engine/src/types/*"],
      "@engine/*": ["../../packages/engine/src/engine/*"],
      "@rules/*": ["../../packages/engine/src/shared/*"],
      "@library/*": ["../../packages/engine/src/library/*"],
      "@config": ["../../packages/engine/src/config"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../packages/engine/src/types/**/*.ts",
    "../../packages/engine/src/engine/**/*.ts",
    "../../packages/engine/src/shared/**/*.ts",
    "../../packages/engine/src/library/**/*.ts",
    "../../packages/engine/src/config.ts"
  ]
}
