{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "isolatedModules": true, "noEmit": true, "composite": true, "declaration": true,
    "tsBuildInfoFile": "../../build/types/admin.tsbuildinfo", "jsx": "react-jsx", "types": ["vite/client"]
