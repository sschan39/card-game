{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "../../build/types/server",
    "tsBuildInfoFile": "../../build/types/server.tsbuildinfo",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@card-game/engine/*": [
        "../../packages/engine/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/protocol"
    }
  ]
}
